# Copy to .env and fill in. Never commit .env.

# Required: long random string used to sign session cookies.
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Google OAuth 2.0 client (Web application). Authorised redirect URI must be
#   http://localhost:5000/login/google/authorized   (local)
#   https://<your-domain>/login/google/authorized   (production)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Database. Optional locally (defaults to sqlite:///instance/gymllm.db).
# Required in production, e.g. postgresql://user:pass@host:5432/dbname
# DATABASE_URL=

# Local development only: allow OAuth over plain http://localhost.
# Never set this in production.
OAUTHLIB_INSECURE_TRANSPORT=1

# Set to "production" on Render (enables Secure cookies, requires DATABASE_URL).
# FLASK_ENV=production

# Optional: a shared model paid for by the site owner, so visitors can log
# workouts with nothing to configure (works on phones). Groq's free tier needs
# no card: https://console.groq.com/keys. The key never reaches users.
# SITE_LLM_API_KEY=
# SITE_LLM_PROVIDER=groq            # any hosted provider id: groq, gemini, openai, ...
# SITE_LLM_MODEL=                   # defaults to the provider's default model
# SITE_LLM_DAILY_LIMIT=20           # parses per user per day
